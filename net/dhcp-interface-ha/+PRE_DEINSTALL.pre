#!/bin/sh

# Refuse an intentional uninstall while an OPNsense logical interface still
# depends on dhcpha0lagg.  Package upgrades run the old pre-deinstall script too;
# PKG_UPGRADE explicitly distinguishes that safe lifecycle path.
if [ -n "${PKG_UPGRADE:-}" ]; then
    exit 0
fi

config="${PKG_ROOTDIR:-}/conf/config.xml"
if [ -r "${config}" ] && grep -Eq '<if>[[:space:]]*dhcpha0lagg[[:space:]]*</if>' "${config}"; then
    echo "os-dhcp-interface-ha: refusing removal while dhcpha0lagg is still assigned." >&2
    echo "Reassign the managed OPNsense interface away from dhcpha0lagg, apply the change, then remove the plugin." >&2
    exit 1
fi

# Offline package roots have no live interface or service to remove.
if [ -n "${PKG_ROOTDIR:-}" ] && [ "${PKG_ROOTDIR}" != / ]; then
    exit 0
fi

controller=/usr/local/opnsense/scripts/dhcp_interface_ha/dhcp_interface_ha.py
/usr/local/bin/python3 "$controller" suspend || exit 1
if /usr/local/etc/rc.d/dhcp_interface_ha onestatus >/dev/null 2>&1; then
    /usr/local/etc/rc.d/dhcp_interface_ha onestop || exit 1
fi
/usr/local/bin/python3 "$controller" remove || exit 1
exit 0
