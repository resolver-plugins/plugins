#!/bin/sh

# Refuse an intentional uninstall while an OPNsense logical interface still
# depends on wanha0lagg.  Package upgrades run the old pre-deinstall script too;
# PKG_UPGRADE explicitly distinguishes that safe lifecycle path.
if [ -n "${PKG_UPGRADE:-}" ]; then
    exit 0
fi

config="${PKG_ROOTDIR:-}/conf/config.xml"
if [ -r "${config}" ] && grep -Eq '<if>[[:space:]]*wanha0lagg[[:space:]]*</if>' "${config}"; then
    echo "os-wan-ha-dhcp: refusing removal while wanha0lagg is still assigned." >&2
    echo "Reassign the managed OPNsense interface away from wanha0lagg, apply the change, then remove the plugin." >&2
    exit 1
fi

# Offline package roots have no live interface or service to remove.
if [ -n "${PKG_ROOTDIR:-}" ] && [ "${PKG_ROOTDIR}" != / ]; then
    exit 0
fi

controller=/usr/local/opnsense/scripts/wan_ha_dhcp/wan_ha_dhcp.py
/usr/local/bin/python3 "$controller" suspend || exit 1
if /usr/local/etc/rc.d/wan_ha_dhcp onestatus >/dev/null 2>&1; then
    /usr/local/etc/rc.d/wan_ha_dhcp onestop || exit 1
fi
/usr/local/bin/python3 "$controller" remove || exit 1
exit 0
