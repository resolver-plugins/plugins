<model>
    <mount>//OPNsense/WanHaDhcpShared</mount>
    <version>1.0.0</version>
    <description>WAN HA DHCP shared settings</description>
    <items>
        <enabled type="BooleanField">
            <Default>0</Default>
            <Required>Y</Required>
        </enabled>
        <managed_interface type="InterfaceField">
            <Default>wan</Default>
            <Required>Y</Required>
        </managed_interface>
        <shared_mac type="MacAddressField">
            <Required>N</Required>
        </shared_mac>
        <failback_delay type="IntegerField">
            <Default>0</Default>
            <Required>Y</Required>
            <MinimumValue>0</MinimumValue>
            <MaximumValue>86400</MaximumValue>
        </failback_delay>
    </items>
</model>
