#!/bin/sh
# Only the controller's explicit verified-incapacity result requests demotion.
# Missing files/interpreter during package replacement must not masquerade as it.
/usr/local/bin/python3 /usr/local/opnsense/scripts/dhcp_interface_ha/dhcp_interface_ha.py health
result=$?
if [ "$result" -eq 100 ]; then
    exit 1
fi
if [ "$result" -ne 0 ]; then
    logger -t dhcp_interface_ha 'Health controller unavailable; unverified demotion withheld'
fi
exit 0
