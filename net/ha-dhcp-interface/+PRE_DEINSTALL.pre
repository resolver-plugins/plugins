#!/bin/sh

# Package upgrades run the old pre-deinstall script too; PKG_UPGRADE
# explicitly distinguishes that safe lifecycle path.
if [ -n "${PKG_UPGRADE:-}" ]; then
    exit 0
fi

# pkg ignores a failing pre-deinstall script and deletes the files anyway, so
# a refusal cannot stop removal. Replacing this package with its -devel or
# release counterpart, or os-dhcp-interface-ha with os-ha-dhcp-interface, is a
# removal without PKG_UPGRADE. While an OPNsense logical interface depends on
# dhcpha0lagg, keep the device and the running controller as an upgrade does,
# and tell an uninstalling operator what is left.
config="${PKG_ROOTDIR:-}/conf/config.xml"
if [ -r "${config}" ] && grep -Eq '<if>[[:space:]]*dhcpha0lagg[[:space:]]*</if>' "${config}"; then
    echo "os-ha-dhcp-interface: dhcpha0lagg is still assigned; leaving the device and controller in place." >&2
    echo "This is expected when os-ha-dhcp-interface replaces os-dhcp-interface-ha or switches to or from its -devel package." >&2
    echo "To uninstall, reinstall the plugin, reassign the interface away from dhcpha0lagg, apply, then remove it." >&2
    exit 0
fi

# Offline package roots have no live interface or service to remove.
if [ -n "${PKG_ROOTDIR:-}" ] && [ "${PKG_ROOTDIR}" != / ]; then
    exit 0
fi

controller=/usr/local/opnsense/scripts/dhcp_interface_ha/dhcp_interface_ha.py
/usr/local/bin/python3 "$controller" suspend || exit 1
if /usr/local/etc/rc.d/dhcp_interface_ha onestatus >/dev/null 2>&1; then
    /usr/local/etc/rc.d/dhcp_interface_ha onestop || exit 1
fi
/usr/local/bin/python3 "$controller" remove || exit 1
exit 0
